  "description": "Testes e validação do marketplace estático, Edge Functions e entregas antifraude.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --test --test-concurrency=4 tests/*.test.cjs tests/*.test.mjs",
