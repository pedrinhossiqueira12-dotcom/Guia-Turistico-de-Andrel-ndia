    "check:edge": "npx --yes deno check --node-modules-dir=auto supabase/functions/catalogo-entregas/index.ts supabase/functions/catalogo-pedidos-offline-admin/index.ts supabase/functions/catalogo-pedido-offline/index.ts supabase/functions/catalogo-pedido-pix/index.ts supabase/functions/mercadopago-marketplace-webhook/index.ts supabase/functions/catalogo-fatura-pix/index.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8"
  }
}
